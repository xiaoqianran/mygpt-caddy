[Unit]
Description=MyGPT Caddy Action Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root
EnvironmentFile=/etc/mygpt-caddy.env
ExecStart=/usr/local/bin/mygpt-caddy
Restart=on-failure
RestartSec=3
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target

