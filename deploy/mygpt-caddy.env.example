API_TOKEN=replace-with-openssl-rand-hex-32
ACTION_BASE_URL=https://action.example.com
LISTEN_ADDR=127.0.0.1:8787
WORKSPACE_ROOT=/root
STATE_DIR=/var/lib/mygpt-caddy
COMMAND_TIMEOUT_SECONDS=38
INLINE_OUTPUT_CHARS=30000
MAX_ARTIFACT_BYTES=10000000
MAX_INPUT_FILE_BYTES=10000000
ARTIFACT_TTL_SECONDS=900
# Optional comma-separated allowlist, for example g-abc123.
ALLOWED_GPT_IDS=
# Restrict temporary conversation-file downloads to OpenAI-hosted URLs.
ALLOWED_UPLOAD_HOSTS=.oaiusercontent.com
AUDIT_ENABLED=true
AUDIT_DIR=/var/lib/mygpt-caddy/audit
AUDIT_RETENTION_DAYS=30
AUDIT_FSYNC=true
# Store this many trailing stdout/stderr characters per command; 0 stores hashes and sizes only.
AUDIT_OUTPUT_CHARS=4000
